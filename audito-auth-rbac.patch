diff --git a/app/auth/complete/page.tsx b/app/auth/complete/page.tsx
new file mode 100644
index 0000000..6c0979d
--- /dev/null
+++ b/app/auth/complete/page.tsx
@@ -0,0 +1,85 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import Link from "next/link";
+import { Loader2 } from "lucide-react";
+import AuthLayout, { Notice } from "@/components/auth/auth-layout";
+import { createClient, setActiveOrganizationId } from "@/lib/auth";
+import { AUTH_ERROR_MESSAGES } from "@/lib/auth-config";
+
+/**
+ * Completes implicit-flow links (tokens in the URL fragment), e.g. admin
+ * invitations sent by inviteUserByEmail with the default email template.
+ */
+export default function AuthCompletePage() {
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    (async () => {
+      const hash = new URLSearchParams(window.location.hash.replace(/^#/, ""));
+      const query = new URLSearchParams(window.location.search);
+
+      const hashError = hash.get("error_description") || hash.get("error_code");
+      if (hashError) {
+        setError(AUTH_ERROR_MESSAGES.link_expired);
+        return;
+      }
+
+      const accessToken = hash.get("access_token");
+      const refreshToken = hash.get("refresh_token");
+      const type = hash.get("type") || "";
+
+      // Drop tokens from the address bar and history immediately.
+      window.history.replaceState({}, document.title, window.location.pathname + window.location.search);
+
+      const supabase = createClient();
+      if (accessToken && refreshToken) {
+        const { error: sessionError } = await supabase.auth.setSession({
+          access_token: accessToken,
+          refresh_token: refreshToken,
+        });
+        if (sessionError) {
+          setError(AUTH_ERROR_MESSAGES.link_expired);
+          return;
+        }
+      } else {
+        const { data } = await supabase.auth.getSession();
+        if (!data.session) {
+          setError(AUTH_ERROR_MESSAGES.missing_code);
+          return;
+        }
+      }
+
+      const response = await fetch("/api/auth/finalize", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ type, next: query.get("next") }),
+      });
+      const result = await response.json();
+      if (!response.ok) {
+        setError(result.error || AUTH_ERROR_MESSAGES.session_error);
+        return;
+      }
+      if (result.organizationId) setActiveOrganizationId(result.organizationId);
+      window.location.replace(result.redirectTo || "/dashboard");
+    })().catch(() => setError(AUTH_ERROR_MESSAGES.session_error));
+  }, []);
+
+  return (
+    <AuthLayout>
+      {error ? (
+        <div className="space-y-5">
+          <h2 className="text-2xl font-semibold">Sign-in could not be completed</h2>
+          <Notice tone="error">{error}</Notice>
+          <Link href="/login" className="block text-sm text-slate-700 hover:underline">
+            Back to sign in
+          </Link>
+        </div>
+      ) : (
+        <div className="flex items-center gap-3 text-sm text-gray-600">
+          <Loader2 size={18} className="animate-spin" /> Completing sign-in…
+        </div>
+      )}
+    </AuthLayout>
+  );
+}
diff --git a/app/auth/confirm/route.ts b/app/auth/confirm/route.ts
new file mode 100644
index 0000000..3166f2a
--- /dev/null
+++ b/app/auth/confirm/route.ts
@@ -0,0 +1,57 @@
+import { NextResponse } from "next/server";
+import type { EmailOtpType } from "@supabase/supabase-js";
+import { createRouteClient } from "@/lib/supabase-server";
+import { finalizeSignIn } from "@/lib/auth-finalize";
+import { safeNextPath } from "@/lib/auth-config";
+import { clientIp } from "@/lib/turnstile";
+import { setActiveOrgCookie } from "@/lib/auth-session";
+
+export const dynamic = "force-dynamic";
+
+const TYPES: EmailOtpType[] = ["invite", "recovery", "signup", "email", "magiclink", "email_change"];
+
+/**
+ * token_hash email links (recommended for SSR; works across devices):
+ *   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=invite
+ *   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery
+ *   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=signup
+ * See AUTH_SETUP.md for the email template changes.
+ */
+export async function GET(request: Request) {
+  const url = new URL(request.url);
+  const origin = url.origin;
+  const tokenHash = url.searchParams.get("token_hash");
+  const type = url.searchParams.get("type") as EmailOtpType | null;
+
+  if (!tokenHash || !type || !TYPES.includes(type)) {
+    return NextResponse.redirect(new URL("/login?error=link_expired", origin));
+  }
+
+  const supabase = createRouteClient();
+  const { data, error } = await supabase.auth.verifyOtp({ token_hash: tokenHash, type });
+
+  if (error || !data.user) {
+    return NextResponse.redirect(new URL("/login?error=link_expired", origin));
+  }
+
+  const result = await finalizeSignIn(data.user, { provider: "email", ip: clientIp(request) });
+
+  if (result.status === "denied") {
+    await supabase.auth.signOut();
+    return NextResponse.redirect(new URL(`/login?error=${encodeURIComponent(result.reason)}`, origin));
+  }
+
+  if (result.status === "pending") {
+    return NextResponse.redirect(new URL("/auth/pending", origin));
+  }
+
+  // Invited users and recovery links must choose a password first.
+  const next =
+    type === "invite"
+      ? "/auth/reset-password?mode=invite"
+      : type === "recovery"
+        ? "/auth/reset-password"
+        : safeNextPath(url.searchParams.get("next"));
+
+  return setActiveOrgCookie(NextResponse.redirect(new URL(next, origin)), result.organizationId);
+}
