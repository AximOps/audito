@@ -0,0 +1,45 @@
+import { NextResponse } from "next/server";
+import { createRouteClient } from "@/lib/supabase-server";
+import { AUTH_ERROR_MESSAGES, authMethods, siteUrl } from "@/lib/auth-config";
+import { forwardCaptchaToSupabase, verifyTurnstile } from "@/lib/turnstile";
+import { jsonError, readJson } from "@/lib/auth-session";
+
+export const dynamic = "force-dynamic";
+
+const GENERIC =
+  "If an account exists for this email address, a password reset link has been sent.";
+
+export async function POST(request: Request) {
+  if (!authMethods.email) return jsonError(AUTH_ERROR_MESSAGES.provider_disabled, 403);
+
+  const body = await readJson(request);
+  const email = typeof body.email === "string" ? body.email.trim().toLowerCase() : "";
+  const captchaToken = typeof body.captchaToken === "string" ? body.captchaToken : undefined;
+
+  if (!email || email.length > 320 || !email.includes("@")) {
+    return jsonError("Enter a valid email address.", 400);
+  }
+
+  const captcha = await verifyTurnstile(captchaToken, request, "forgot_password");
+  if (!captcha.ok) return jsonError(AUTH_ERROR_MESSAGES.captcha_failed, 400, { code: "captcha_failed" });
+
+  const supabase = createRouteClient();
+  const { error } = await supabase.auth.resetPasswordForEmail(email, {
+    // Server-initiated PKCE: the code verifier cookie is set on this response,
+    // so the link must be opened in the same browser. /auth/confirm also
+    // supports token_hash links (see AUTH_SETUP.md) that work on any device.
+    redirectTo: `${siteUrl(request)}/auth/callback?next=${encodeURIComponent("/auth/reset-password")}`,
+    captchaToken: forwardCaptchaToSupabase("forgot_password") ? captchaToken : undefined,
+  });
+
+  if (error) {
+    if (/captcha/i.test(error.message)) {
+      return jsonError(AUTH_ERROR_MESSAGES.captcha_failed, 400, { code: "captcha_failed" });
+    }
+    if (error.status === 429) return jsonError("Too many requests. Please wait and try again.", 429);
+    // Other errors are logged but not exposed (no account enumeration).
+    console.error("resetPasswordForEmail:", error.message);
+  }
+
+  return NextResponse.json({ success: true, message: GENERIC });
+}
diff --git a/app/api/auth/login/route.ts b/app/api/auth/login/route.ts
new file mode 100644
index 0000000..f9e7c3f
--- /dev/null
+++ b/app/api/auth/login/route.ts
@@ -0,0 +1,66 @@
+import { NextResponse } from "next/server";
+import { createRouteClient } from "@/lib/supabase-server";
+import { finalizeSignIn } from "@/lib/auth-finalize";
+import { AUTH_ERROR_MESSAGES, authMethods, safeNextPath } from "@/lib/auth-config";
+import { clientIp, forwardCaptchaToSupabase, verifyTurnstile } from "@/lib/turnstile";
+import { jsonError, readJson, setActiveOrgCookie } from "@/lib/auth-session";
+
+export const dynamic = "force-dynamic";
+
+// Generic message: never reveal whether the email exists.
+const INVALID = "Invalid email or password.";
+
+export async function POST(request: Request) {
+  if (!authMethods.email) return jsonError(AUTH_ERROR_MESSAGES.provider_disabled, 403);
+
+  const body = await readJson(request);
+  const email = typeof body.email === "string" ? body.email.trim().toLowerCase() : "";
+  const password = typeof body.password === "string" ? body.password : "";
+  const captchaToken = typeof body.captchaToken === "string" ? body.captchaToken : undefined;
+
+  if (!email || !password || email.length > 320 || password.length > 512) {
+    return jsonError(INVALID, 400);
+  }
+
+  const captcha = await verifyTurnstile(captchaToken, request, "login");
+  if (!captcha.ok) return jsonError(AUTH_ERROR_MESSAGES.captcha_failed, 400, { code: "captcha_failed" });
+
+  const supabase = createRouteClient();
+  const { data, error } = await supabase.auth.signInWithPassword({
+    email,
+    password,
+    options: forwardCaptchaToSupabase("login") ? { captchaToken } : undefined,
+  });
+
+  if (error || !data.user) {
+    const message = error?.message || "";
+    if (/captcha/i.test(message)) {
+      return jsonError(AUTH_ERROR_MESSAGES.captcha_failed, 400, { code: "captcha_failed" });
+    }
+    if (/email not confirmed/i.test(message)) {
+      return jsonError(AUTH_ERROR_MESSAGES.email_unverified, 403, { code: "email_unverified" });
+    }
+    if (error?.status === 429) return jsonError("Too many attempts. Please wait and try again.", 429);
+    return jsonError(INVALID, 401);
+  }
+
+  const result = await finalizeSignIn(data.user, { provider: "email", ip: clientIp(request) });
+
+  if (result.status === "denied") {
+    await supabase.auth.signOut();
+    return jsonError(AUTH_ERROR_MESSAGES[result.reason] || AUTH_ERROR_MESSAGES.not_provisioned, 403, {
+      code: result.reason,
+    });
+  }
+
+  if (result.status === "pending") {
+    return NextResponse.json({ success: true, redirectTo: "/auth/pending" });
+  }
+
+  const response = NextResponse.json({
+    success: true,
+    organizationId: result.organizationId,
+    redirectTo: safeNextPath(body.next),
+  });
+  return setActiveOrgCookie(response, result.organizationId);
+}
diff --git a/app/api/auth/oauth/route.ts b/app/api/auth/oauth/route.ts
new file mode 100644
index 0000000..b65ec71
--- /dev/null
+++ b/app/api/auth/oauth/route.ts
@@ -0,0 +1,50 @@
+import { NextResponse } from "next/server";
+import { createRouteClient } from "@/lib/supabase-server";
+import {
+  AUTH_ERROR_MESSAGES,
+  isOAuthProvider,
+  isProviderEnabled,
+  safeNextPath,
+  siteUrl,
+} from "@/lib/auth-config";
+import { verifyTurnstile } from "@/lib/turnstile";
+import { jsonError, readJson } from "@/lib/auth-session";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * Starts Google / Microsoft sign-in. Runs server-side so the Turnstile token
+ * is verified before the provider redirect, and the PKCE code verifier is
+ * stored in a cookie that /auth/callback reads.
+ */
+export async function POST(request: Request) {
+  const body = await readJson(request);
+  const provider = body.provider;
+
+  if (!isOAuthProvider(provider)) return jsonError("Unsupported provider.", 400);
+  if (!isProviderEnabled(provider)) return jsonError(AUTH_ERROR_MESSAGES.provider_disabled, 403);
+
+  const captcha = await verifyTurnstile(body.captchaToken, request, "oauth");
+  if (!captcha.ok) return jsonError(AUTH_ERROR_MESSAGES.captcha_failed, 400, { code: "captcha_failed" });
+
+  const next = safeNextPath(body.next);
+  const redirectTo = `${siteUrl(request)}/auth/callback?provider=${provider}&next=${encodeURIComponent(next)}`;
+
+  const supabase = createRouteClient();
+  const { data, error } = await supabase.auth.signInWithOAuth({
+    provider,
+    options: {
+      redirectTo,
+      skipBrowserRedirect: true,
+      // Microsoft requires the email scope for Supabase to receive an address.
+      scopes: provider === "azure" ? "openid email profile offline_access" : undefined,
+      queryParams: { prompt: "select_account" },
+    },
+  });
+
+  if (error || !data.url) {
+    return jsonError(error?.message || "Unable to start sign-in.", 400);
+  }
+
+  return NextResponse.json({ url: data.url });
+}
