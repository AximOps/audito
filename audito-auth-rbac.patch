+# --- Supabase -------------------------------------------------------------
 NEXT_PUBLIC_SUPABASE_URL=
 NEXT_PUBLIC_SUPABASE_ANON_KEY=
+# Server only. Never expose to the browser.
 SUPABASE_SERVICE_ROLE_KEY=
+# Public URL of this app; must match Supabase Auth > URL Configuration.
 NEXT_PUBLIC_SITE_URL=http://localhost:3000
+
+# --- Sign-in methods ------------------------------------------------------
+# Providers must also be enabled in Supabase Auth > Providers.
+NEXT_PUBLIC_AUTH_EMAIL_ENABLED=true
+NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
+NEXT_PUBLIC_AUTH_MICROSOFT_ENABLED=false
+# Allow email/password self-registration (access still needs approval).
+NEXT_PUBLIC_AUTH_SIGNUP_ENABLED=false
+
+# Users who authenticate with no invitation and no verified domain:
+#   deny    - refuse sign-in (default)
+#   pending - keep a Pending directory record for Platform Admin approval
+AUTH_UNKNOWN_USER_POLICY=deny
+
+# --- Cloudflare Turnstile -------------------------------------------------
+# Leave the site key empty to disable the widget (local development).
+NEXT_PUBLIC_TURNSTILE_SITE_KEY=
+TURNSTILE_SECRET_KEY=
+# app      - this server verifies tokens (default)
+# supabase - Supabase Auth captcha protection verifies tokens (set the same
+#            secret in Supabase > Auth > Attack Protection); recommended.
+TURNSTILE_MODE=app
+# Optional: reject tokens issued for another hostname, e.g. audit.example.com
+TURNSTILE_EXPECTED_HOSTNAME=
