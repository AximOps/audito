+              {domains.map((d) => (
+                <div key={d.domain} className="p-4 grid md:grid-cols-[1fr_auto_auto_auto] gap-4 items-center">
+                  <div className="font-medium text-sm">@{d.domain}</div>
+                  <label className="text-sm flex items-center gap-2">
