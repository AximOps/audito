+              </tr>
+            </thead>
+            <tbody className="divide-y">
+              {MATRIX_ROWS.map((row) => (
+                <tr key={row.key}>
+                  <td className="px-5 py-2.5 font-medium">{row.label}</td>
+                  {ROLE_OPTIONS.map((r) => {
+                    const value = level(row.key, r);
